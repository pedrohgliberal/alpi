#!/bin/bash
# nvidia-kmod-check — does the newest installed kernel have an NVIDIA module? (ALPI, roles/nvidia)
# AlmaLinux's prebuilt modules can arrive after a new kernel: until then, keep booting the older
# kernel from GRUB. Exit 0 when the module is there, 1 when it is not.

# kernel-core, as roles/update's reboot gate: the package with the kernel image itself
if ! versions=$(rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n'); then
    echo "nvidia-kmod-check: no kernel-core installed" >&2
    exit 1
fi
newest=$(sort -V <<<"$versions" | tail -1)

if modinfo -k "$newest" nvidia >/dev/null 2>&1; then
    echo "OK: nvidia available for $newest"
else
    echo "WARNING: no nvidia module for $newest. Do not reboot into it yet."
    exit 1
fi
